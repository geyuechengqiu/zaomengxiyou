; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="zaomengxiyou"
run/main_scene="res://game/levels/biyujing.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CoreSystem="*res://addons/godot_core_system-0.0.4/source/core_system.gd"
GameplayAbilitySystem="*uid://u2lf4qtnkmft"
DamageCalculator="*uid://b2jxgcjagrkdx"
TagManager="*uid://crdi6238nttlg"
GameplayCueManager="*uid://b4t83autfu2j7"
BattleSystem="*res://addons/battle_foundation/runtime/battle_system.gd"
Panku="*res://addons/panku_console/console.tscn"
DebugDraw="*res://addons/zylann.debug_draw/debug_draw.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[battle_foundation]

manifest_path="res://data/battle/manifest.json"

[display]

window/size/viewport_width=940
window/size/viewport_height=590
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gameplay_abiltiy_system/plugin.cfg", "res://addons/godot_core_system-0.0.4/plugin.cfg", "res://addons/panku_console/plugin.cfg", "res://addons/simple_inventory/plugin.cfg", "res://addons/battle_foundation/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[phantom_camera]

updater/updater_mode=0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
