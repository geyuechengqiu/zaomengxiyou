<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 编辑器与脚本共用配套缓存，避免加载全局缓存中的标准 GodotSharp。 -->
    <add key="globalPackagesFolder" value=".godot/mono/nuget-cache" />
  </config>
  <packageSources>
    <clear />
    <!-- Spine模块的C#程序集必须与自定义引擎匹配，由bootstrap.ps1复制。 -->
    <add key="SpineGodot" value=".godot/mono/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="SpineGodot">
      <package pattern="Godot.*" />
      <package pattern="GodotSharp*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
