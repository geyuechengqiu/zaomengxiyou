spawn_plans = Array[ExtResource("plans_type")]([ExtResource("screen1_birth1"), ExtResource("screen1_birth2"), ExtResource("screen1_birth3"), ExtResource("screen1_birth4"), ExtResource("screen2_birth5"), ExtResource("screen2_birth6"), ExtResource("screen2_birth7"), ExtResource("screen2_birth8"), ExtResource("screen3_birth9"), ExtResource("screen3_birth10"), ExtResource("screen3_birth11"), ExtResource("screen3_birth12"), ExtResource("screen4_birth13"), ExtResource("screen5_birth14"), ExtResource("screen4_birth15"), ExtResource("screen5_birth16"), ExtResource("revival_vessel_birth"), ExtResource("jushi_lingjun_birth")])
required_boss_plan_ids = Array[StringName]([&"jushi_lingjun_birth"])
