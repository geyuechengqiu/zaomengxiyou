ability_ids = Array[StringName]([&"sunwukong_attack1", &"sunwukong_attack2", &"sunwukong_attack3", &"sunwukong_attack4", &"sunwukong_attack5", &"sunwukong_run_attack", &"sunwukong_jump_attack", &"sunwukong_skill1", &"sunwukong_skill2", &"sunwukong_skill3", &"sunwukong_skill4", &"sunwukong_skill4_1", &"sunwukong_skill8", &"sunwukong_skill8_slam", &"sunwukong_wushuang"])
