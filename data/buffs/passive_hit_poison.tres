[gd_resource type="Resource" script_class="GameplayStatusData" format=3]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/gameplay_status_data.gd" id="status"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/effects/gameplay_effect.gd" id="effect_type"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/features/status_feature.gd" id="feature_type"]
[ext_resource type="Script" path="res://addons/battle_foundation/gas/battle_trigger_feature.gd" id="trigger"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/effects/ge_apply_status.gd" id="effect"]
[ext_resource type="Resource" path="res://data/buffs/poison.tres" id="child"]
[sub_resource type="Resource" id="effect"]
script = ExtResource("effect")
status_data = ExtResource("child")
[sub_resource type="Resource" id="trigger"]
script = ExtResource("trigger")
feature_name = "passive_hit_poison_trigger"
trigger_on_events = Array[StringName]([&"battle.hit.effective"])
owner_role = 0
effect_target = 2
effects = Array[ExtResource("effect_type")]([SubResource("effect")])
cooldown = 1.0
[resource]
script = ExtResource("status")
status_id = &"passive_hit_poison"
status_display_name = "组合被动验收：passive_hit_poison"
duration = -1.0
features = Array[ExtResource("feature_type")]([SubResource("trigger")])
metadata/test_composition = true
