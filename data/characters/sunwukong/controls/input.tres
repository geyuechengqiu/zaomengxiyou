[gd_resource type="Resource" script_class="CoreOperationProfile" format=3]
[ext_resource type="Script" path="res://addons/godot_core_system-0.0.4/source/operation_system/operation_profile.gd" id="script"]

[resource]
script = ExtResource("script")
bindings = {
&"move_left": [&"battle_player.left"], &"move_right": [&"battle_player.right"],
&"move_up": [&"battle_player.up"], &"move_down": [&"battle_player.down"],
&"run": [&"battle_player.run"], &"jump": [&"battle_player.jump"], &"attack": [&"battle_player.attack"],
&"skill_1": [&"battle_player.skill_1"], &"skill_2": [&"battle_player.skill_2"], &"skill_3": [&"battle_player.skill_3"],
&"skill_4": [&"battle_player.skill_4"], &"skill_5": [&"battle_player.skill_5"],
&"magic_weapon": [&"battle_player.magic_weapon"], &"wushuang": [&"battle_player.wushuang"],
&"wing_skill": [&"battle_player.wing_skill"], &"ultimate": [&"battle_player.ultimate"],
&"item_1": [&"battle_player.item_1"], &"item_2": [&"battle_player.item_2"],
&"pet_toggle": [&"battle_player.pet_toggle"], &"mount_toggle": [&"battle_player.mount_toggle"]
}
