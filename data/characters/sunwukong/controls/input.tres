&"vertical": {"negative": &"move_up", "positive": &"move_down", "opposites": "last_pressed"}
}
default_keys = {
&"battle_player.left": ["A", "Left"], &"battle_player.right": ["D", "Right"],
&"battle_player.up": ["W", "Up"], &"battle_player.down": ["S", "Down"],
&"battle_player.run": ["Shift"], &"battle_player.jump": ["K"], &"battle_player.attack": ["J"],
&"battle_player.skill_1": ["Y"], &"battle_player.skill_2": ["U"], &"battle_player.skill_3": ["I"],
&"battle_player.skill_4": ["O"], &"battle_player.skill_5": ["L"],
&"battle_player.magic_weapon": ["H"], &"battle_player.wushuang": ["Space"],
&"battle_player.wing_skill": ["R"], &"battle_player.ultimate": ["P"],
&"battle_player.item_1": ["Q"], &"battle_player.item_2": ["E"],
&"battle_player.pet_toggle": ["F"], &"battle_player.mount_toggle": ["Z"]
}
buffered_intents = Array[StringName]([&"jump", &"attack", &"skill_1", &"skill_2", &"skill_3", &"skill_4", &"skill_5", &"magic_weapon", &"wushuang", &"wing_skill", &"ultimate", &"item_1", &"item_2", &"pet_toggle", &"mount_toggle"])
