[gd_resource type="Resource" script_class="CharacterAnimationProfile" format=3]
[ext_resource type="Script" path="res://addons/battle_foundation/animation/character_animation_profile.gd" id="script"]
[ext_resource type="SpineSkeletonDataResource" path="res://assets/skelton/char/sunwukong/sunwukong_spinedata.tres" id="data"]

[resource]
script = ExtResource("script")
skeleton_data = ExtResource("data")
source_fps = 30.0
animations = Dictionary[StringName, StringName]({&"idle": &"idle", &"move": &"walk", &"run": &"runNormal", &"jump": &"jumpNormal", &"jump_2": &"jumpTwo", &"fall": &"jumpDown", &"land": &"idle", &"hurt": &"hurtStand", &"death": &"dead", &"attack_1": &"attack1", &"attack_2": &"attack2", &"attack_3": &"attack3", &"attack_4": &"attack4", &"attack_5": &"attack5", &"run_attack": &"runAttack", &"jump_attack": &"jumpAttack"})
looping_actions = Array[StringName]([&"idle", &"move", &"run"])
base_skin = &"基础"
display_scale = 2.0
skeleton_offset = Vector2(0, -4.2384)
socket_bones = Dictionary[StringName, StringName]({&"root": &"root", &"foot_left": &"yf_脚1", &"foot_right": &"yf_脚2", &"head": &"mz_头", &"weapon": &"wq_武器", &"weapon_alt": &"wq_武器_0", &"weapon_long": &"wq_3"})
socket_slots = Dictionary[StringName, StringName]({&"foot_left": &"yf_脚1", &"foot_right": &"yf_脚2", &"head": &"mz_头", &"weapon": &"wq_武器", &"weapon_alt": &"wq_武器_0", &"weapon_long": &"wq_3"})
