event_id = &"battle.skill.object"
payload = {
"lifetime": 0.5,
"object_path": NodePath("SkillTrail"),
"spawn_offset": Vector2(65, -110)
}

[sub_resource type="Resource" id="animation2"]
script = ExtResource("event")
source_frame = 8
