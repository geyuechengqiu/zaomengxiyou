[gd_resource type="Resource" script_class="GameplayStatusData" format=3]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/gameplay_status_data.gd" id="status"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/effects/gameplay_effect.gd" id="effect_type"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/effects/ge_attribute_modifier.gd" id="effect"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/attributes/gameplay_attribute_modifier.gd" id="modifier"]
[sub_resource type="Resource" id="attack"]
script = ExtResource("modifier")
attribute_id = &"atk"
value = 0.2
modifier_type = 1
[sub_resource type="Resource" id="health"]
script = ExtResource("modifier")
attribute_id = &"hpMax"
value = 100.0
[sub_resource type="Resource" id="effect"]
script = ExtResource("effect")
modifiers = Array[ExtResource("modifier")]([SubResource("attack"), SubResource("health")])
[resource]
script = ExtResource("status")
status_id = &"attribute_test_buff"
status_display_name = "属性验收 Buff（8 秒）"
duration = 8.0
apply_effects = Array[ExtResource("effect_type")]([SubResource("effect")])
