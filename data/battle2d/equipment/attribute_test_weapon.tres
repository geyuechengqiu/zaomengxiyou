[gd_resource type="Resource" script_class="BattleInventoryEquipment" format=3]
[ext_resource type="Script" path="res://addons/battle_foundation/definitions/battle_inventory_equipment.gd" id="item"]
[ext_resource type="Script" path="res://addons/battle_foundation/definitions/battle_equipment_definition.gd" id="definition"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/attributes/gameplay_attribute_modifier.gd" id="modifier"]
[sub_resource type="Resource" id="attack"]
script = ExtResource("modifier")
attribute_id = &"atk"
value = 10.0
[sub_resource type="Resource" id="health"]
script = ExtResource("modifier")
attribute_id = &"hpMax"
value = 50.0
[sub_resource type="Resource" id="definition"]
script = ExtResource("definition")
definition_id = &"attribute_test_weapon"
display_name = "属性验收武器（非原版装备）"
slot_id = &"weapon"
attribute_modifiers = Array[ExtResource("modifier")]([SubResource("attack"), SubResource("health")])
[resource]
script = ExtResource("item")
name = "属性验收武器"
description = "攻击+10，最大生命+50；仅用于属性链验收。"
equip_type = 6
battle_definition = SubResource("definition")
