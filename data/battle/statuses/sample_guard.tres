[gd_resource type="Resource" script_class="GameplayStatusData" format=3]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/gameplay_status_data.gd" id="definition"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/features/status_feature.gd" id="feature_type"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/features/feature_event_listener.gd" id="listener"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/effects/gameplay_effect.gd" id="effect_type"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/effects/ge_modify_incoming_damage.gd" id="reduce"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/stacking/stacking_refresh_and_stack.gd" id="stacking"]

[sub_resource type="Resource" id="Reduce"]
script = ExtResource("reduce")
damage_multiplier = 0.5

[sub_resource type="Resource" id="Listener"]
script = ExtResource("listener")
trigger_on_events = Array[StringName]([&"damage_received"])
event_triggered_effects = Array[ExtResource("effect_type")]([SubResource("Reduce")])

[sub_resource type="Resource" id="Stacking"]
script = ExtResource("stacking")

[resource]
script = ExtResource("definition")
status_id = &"sample_guard"
status_display_name = "阶段一减伤状态"
duration = 3.0
max_stacks = 3
stacking_policy = SubResource("Stacking")
features = Array[ExtResource("feature_type")]([SubResource("Listener")])
